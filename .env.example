# PowerNetPro website — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets (TRD 6).

# --- Public site ---
NEXT_PUBLIC_SITE_URL="https://www.powernetpro.in"

# --- Analytics (GA4) — TRD 7 ---
# When set, the analytics shim forwards events to gtag; leave empty in dev.
NEXT_PUBLIC_GA_ID=""

# --- Form spam protection (Cloudflare Turnstile) — TRD 6 ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Object storage for bill uploads (S3-compatible) — TRD 5.1 ---
# Bills upload direct-to-storage via pre-signed URLs. Enforce SSE + 12-month
# lifecycle deletion + no public access on the bucket.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Transactional email (Resend or SES) — PRD F-11/F-12 ---
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="PowerNetPro <audit@powernetpro.in>"
SALES_NOTIFICATION_EMAIL="sales@powernetpro.in"

# --- WhatsApp lead notification (Business API) — PRD F-11 ---
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
